# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4060
# Puerta de enlace de docker0, si el reverse proxy corre en un contenedor.
HOST=172.17.0.1

# ── Secreto de la URL del addon ───────────────────────────────────────────────
# Va en la ruta del manifest: quien lo tenga ve el catálogo y los enlaces.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Para revocarlo: cámbialo, reinicia y vuelve a instalar el addon en Stremio.
MERIDA_TOKEN=

# ── Segovia ───────────────────────────────────────────────────────────────────
SEGOVIA_URL=http://172.17.0.1:4040
# Clave de solo lectura: npm run segovia clave addon (en la carpeta de Segovia).
SEGOVIA_CLAVE=
# Subcarpeta dentro de la raíz de Segovia. Vacío: toda la raíz.
# SEGOVIA_RUTA=

# ── Cómo se ve ────────────────────────────────────────────────────────────────
# El nombre del addon y de sus catálogos en Stremio.
# MERIDA_NOMBRE=Mérida
# Lo que sale a la izquierda de cada stream, para reconocerlo de un vistazo.
# MERIDA_ETIQUETA=🏠 Mérida

# ── Funcionamiento ────────────────────────────────────────────────────────────
# proxy: los bytes pasan por Segovia, que aguanta cortes y elige servidor de
# Microsoft. redirect: el reproductor va directo a Microsoft.
# MERIDA_MODO=proxy
# Cada cuántos minutos se relee la carpeta, por si subes algo a mano.
# MERIDA_REFRESCO_MIN=30
